---
import Base from '../layouts/Base.astro';
import DirCard from '../components/DirCard.astro';
import { loadTools, loadUseCases, loadReleases, releasesThisWeek, latestChecked, addedWithinDays, prettyDate, shownDate, TOOL_GROUPS, groupOf } from '../lib/data';
const tools = loadTools().slice().sort((a, b) => a.tool_name.toLowerCase().localeCompare(b.tool_name.toLowerCase()));
const cases = loadUseCases();
const checked = latestChecked(tools);
const releases = releasesThisWeek(loadReleases(), checked);
const addedCount = addedWithinDays(tools, 7).length;
const nameOf = new Map(tools.map((t) => [t.tool_id, t.tool_name]));
const usesOf = (t: Record<string, string>) => cases.filter((u) => u.tools.some((x) => x.toolId === t.tool_id)).length;
const groups = TOOL_GROUPS.map((g) => ({ ...g, list: tools.filter((t) => groupOf(t).id === g.id) })).filter((g) => g.list.length);
---
<Base title="ScaleStack Tech: AI video maker directory, read from vendor pages" description="Ten AI video makers listed from what each vendor publishes, with source links and the date we read them. Desk-researched, no hands-on tests.">
  <div class="topbar" slot="topbar">
    <div class="search" role="search">
      <label for="q" class="vh">Search tools and use cases by name, summary or tool</label>
      <input id="q" type="search" placeholder="Search tools and use cases" autocomplete="off" />
    </div>
  </div>

  <h1>AI video makers, each with the vendor page we read.</h1>
  <p class="lede">A directory of {tools.length} AI video makers, built from public vendor pages. Desk-researched: we have not run the tools. Scores are not shown yet.</p>

  <div class="pillbar">
    <ul class="pills" id="dir-pills" aria-label="Filter by category">
      <li><button type="button" class="pill" data-group="" aria-pressed="true">All <span class="count">{tools.length}</span></button></li>
      {groups.map((g) => <li><button type="button" class="pill" data-group={g.id} aria-pressed="false">{g.name} <span class="count">{g.list.length}</span></button></li>)}
    </ul>
    <p class="stamp"><span id="dir-count">{tools.length}</span> shown · Updated {prettyDate(checked)} · <a href="/methodology/">Methodology</a> · <a href="/rss.xml">RSS feed</a></p>
  </div>
  <p id="search-status" class="src" aria-live="polite"></p>
  <ul id="search-results" class="cards"></ul>

  <section class="newweek" aria-labelledby="nw-h" id="new-week">
    <h2 id="nw-h">New this week</h2>
    {releases.length > 0
      ? <ul class="rel-row">
          {releases.map((r) => <li class="rel"><p class="rel-date">{prettyDate(r.date)}</p><h3>{r.title}</h3><p class="src"><a href={`/tools/${r.toolId}/`}>{nameOf.get(r.toolId) ?? r.toolId}</a> · <a href={r.sourceUrl} rel="nofollow noopener">{r.sourceName}, {prettyDate(r.date)}</a></p></li>)}
        </ul>
      : <p class="note">No dated releases with a public source are recorded for the week to {prettyDate(checked)}. We list a release only when a public page states its date.{addedCount > 0 && ` ${addedCount} tools were added to this directory in that week; they are listed below.`}</p>}
  </section>

  <div id="dir">
    {groups.map((g) => (
      <section class="dir-section" data-group={g.id} id={g.id} aria-labelledby={`h-${g.id}`}>
        <h2 id={`h-${g.id}`}>{g.name} <span class="count">{g.list.length}</span></h2>
        <ul class="dir-list">
          {g.list.map((t) => <DirCard tool={t} group={g} uses={usesOf(t)} />)}
        </ul>
      </section>
    ))}
  </div>
  <p id="dir-empty" class="note" hidden>No tool matches that filter.</p>

  <section aria-labelledby="lu-h">
    <h2 id="lu-h">Latest use cases</h2>
    <ul class="lu-list">
      {cases.slice(0, 4).map((u) => <li><a href={`/use-cases/${u.catSlug}/#uc-${u.id}`}>{u.title}</a> <span class="src">Reported by {u.sourceName}, {shownDate(u.sourceDate)}</span></li>)}
    </ul>
    <p><a href="/use-cases/">See all {cases.length} use cases</a></p>
  </section>

  <aside class="agency" aria-label="About Prospecly">
    <h2>Work with Prospecly, ScaleStack's own agency</h2>
    <p><a href="/services/">Prospecly services</a></p>
    <p><strong>Not part of the directory or the use case feed.</strong></p>
  </aside>
  <script is:inline src="/search.js" defer></script>
  <script is:inline src="/dir.js" defer></script>
</Base>
